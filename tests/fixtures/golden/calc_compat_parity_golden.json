        "expr": "(inputs.fusion_power * inputs.processing_factor)",
        "input_refs": [
          "fusion_power",
          "processing_factor"
        ],
        "intermediate_refs": []
      }
    },
    "VacuumPumpPower": {
      "pump_power": {
        "expr": "((pump_power_per_unit * inputs.pump_count) / inputs.pump_efficiency)",
        "input_refs": [
          "pump_count",
          "pump_efficiency"
        ],
        "intermediate_refs": [
          "pump_power_per_unit"
        ]
      }
    }
  },
