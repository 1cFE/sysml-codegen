  "fusion_tea": {
    "IFE_LCOE": {
      "lcoe": {
        "expr": "(((annual_capital_cost * pvf_construction) + (annual_operating_cost * pvf_operation)) / (annual_energy * pvf_operation))",
        "input_refs": [],
        "intermediate_refs": [
