    "Meier_COE": {
      "coe_cents_kwh": {
        "expr": "((0.113 * inputs.total_capital_billions) / ((0.0876 * inputs.availability_in) * inputs.net_electric_power_gw_in))",
        "input_refs": [
          "total_capital_billions",
          "availability_in",
          "net_electric_power_gw_in"
        ],
        "intermediate_refs": []
      }
    },
    "Meier_HIF_Driver_Cost": {
      "cost_billions": {
        "expr": "(((0.32 + (0.088 * inputs.beam_energy_mj_in)) * (1.25 + (0.05 * inputs.num_chambers_in))) * (1.0 + (0.0088 * (inputs.rep_rate - 5.0))))",
        "input_refs": [
          "beam_energy_mj_in",
          "num_chambers_in",
          "rep_rate"
        ],
        "intermediate_refs": []
      },
      "gamma": {
        "expr": "((cost_billions * 1000000000.0) / bank_energy_joules)",
        "input_refs": [],
        "intermediate_refs": [
          "cost_billions",
          "bank_energy_joules"
        ]
      }
    },
    "Meier_Reactor_Cost": {
      "reactor_cost_billions": {
        "expr": "((0.66 * ((inputs.thermal_power_gw_in / 1.67) ** 0.49)) * ((0.72 * inputs.num_units) + 0.28))",
        "input_refs": [
          "thermal_power_gw_in",
          "num_units"
        ],
        "intermediate_refs": []
      }
    },
    "Meier_Total_Capital_Cost": {
      "total_capital_billions": {
        "expr": "(1.83 * ((inputs.reactor_cost + inputs.driver_cost) + inputs.target_factory_cost))",
        "input_refs": [
          "reactor_cost",
          "driver_cost",
          "target_factory_cost"
        ],
        "intermediate_refs": []
      }
    },
