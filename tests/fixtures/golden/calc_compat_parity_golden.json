  "catf_mfe_model": {
    "AlphaNeutronSplit": {
      "p_alpha": {
        "expr": "((inputs.p_fusion * 3.52) / 17.58)",
        "input_refs": [
          "p_fusion"
        ],
        "intermediate_refs": []
      },
      "p_neutron": {
        "expr": "((inputs.p_fusion * 14.06) / 17.58)",
        "input_refs": [
          "p_fusion"
        ],
        "intermediate_refs": []
      }
    },
    "AuxiliarySystemsPower": {
      "auxiliary_power": {
        "expr": "(inputs.gross_electric * inputs.auxiliary_fraction)",
        "input_refs": [
          "gross_electric",
          "auxiliary_fraction"
        ],
        "intermediate_refs": []
      }
    },
    "BlanketThermalPower": {
      "p_thermal": {
        "expr": "(((inputs.m_neutron * inputs.p_neutron) + inputs.p_input) + ((inputs.eta_thermal * ((inputs.f_pump * inputs.eta_pump) + inputs.f_subsystem)) * (inputs.m_neutron * inputs.p_neutron)))",
        "input_refs": [
          "m_neutron",
          "p_neutron",
          "p_input",
          "eta_thermal",
          "f_pump",
          "eta_pump",
          "f_subsystem"
        ],
        "intermediate_refs": []
      }
    },
    "CoolantPumpPower": {
      "pump_power": {
        "expr": "((inputs.f_pcppf * inputs.p_thermal_electric) / inputs.pump_efficiency)",
        "input_refs": [
          "f_pcppf",
          "p_thermal_electric",
          "pump_efficiency"
        ],
        "intermediate_refs": []
      }
    },
    "CryoPumpRefrigeration": {
      "refrigeration_power": {
        "expr": "((thermal_load * (300.0 / inputs.operating_temp)) / inputs.carnot_efficiency)",
        "input_refs": [
          "operating_temp",
          "carnot_efficiency"
        ],
        "intermediate_refs": [
          "thermal_load"
        ]
      }
    },
    "EngineeringQFactor": {
      "f_recirculating": {
        "expr": "(1.0 / q_eng)",
        "input_refs": [],
        "intermediate_refs": [
          "q_eng"
        ]
      },
      "p_net": {
        "expr": "(inputs.p_electric_gross * (1.0 - f_recirculating))",
        "input_refs": [
          "p_electric_gross"
        ],
        "intermediate_refs": [
          "f_recirculating"
        ]
      },
      "q_eng": {
        "expr": "(inputs.p_electric_gross / inputs.p_auxiliary_total)",
        "input_refs": [
          "p_electric_gross",
          "p_auxiliary_total"
        ],
        "intermediate_refs": []
      }
    },
    "GrossElectricPower": {
      "p_electric_gross": {
        "expr": "((inputs.eta_thermal * inputs.p_thermal) + (inputs.eta_direct * inputs.p_alpha))",
        "input_refs": [
          "eta_thermal",
          "p_thermal",
          "eta_direct",
          "p_alpha"
        ],
        "intermediate_refs": []
      }
    },
    "HeatingWallPlugPower": {
      "wall_plug_power": {
        "expr": "(inputs.delivered_power / inputs.heating_efficiency)",
        "input_refs": [
          "delivered_power",
          "heating_efficiency"
        ],
        "intermediate_refs": []
      }
    },
    "MagnetCryogenicLoad": {
      "cooling_power": {
        "expr": "((thermal_load_cryo / inputs.operating_temp) * (300.0 / inputs.carnot_efficiency))",
        "input_refs": [
          "operating_temp",
          "carnot_efficiency"
        ],
        "intermediate_refs": [
          "thermal_load_cryo"
        ]
      }
    },
    "MagnetSurfaceArea": {
      "area": {
        "expr": "(((((2.0 * 3.14159265359) * inputs.r_inner) * inputs.thickness) * inputs.kappa) * inputs.f_exposed)",
        "input_refs": [
          "r_inner",
          "thickness",
          "kappa",
          "f_exposed"
        ],
        "intermediate_refs": []
      }
    },
    "NetElectricPower": {
      "p_net": {
        "expr": "(inputs.p_electric_gross - p_parasitic_total)",
        "input_refs": [
          "p_electric_gross"
        ],
        "intermediate_refs": [
          "p_parasitic_total"
        ]
      },
      "p_parasitic_total": {
        "expr": "((((((inputs.p_coils + inputs.p_heating) + inputs.p_pumps) + inputs.p_cryo) + inputs.p_vacuum) + inputs.p_tritium) + inputs.p_auxiliary)",
        "input_refs": [
          "p_coils",
          "p_heating",
          "p_pumps",
          "p_cryo",
          "p_vacuum",
          "p_tritium",
          "p_auxiliary"
        ],
        "intermediate_refs": []
      }
    },
    "PlantEfficiency": {
      "eta_plant": {
        "expr": "(inputs.p_net / inputs.p_fusion)",
        "input_refs": [
          "p_net",
          "p_fusion"
        ],
        "intermediate_refs": []
      }
    },
    "PlasmaConfinement": {
      "p_fusion": {
        "expr": "inputs.p_fusion_input",
        "input_refs": [
          "p_fusion_input"
        ],
        "intermediate_refs": []
      }
    },
    "ScientificQFactor": {
      "q_sci": {
        "expr": "(inputs.p_fusion / inputs.p_input)",
        "input_refs": [
          "p_fusion",
          "p_input"
        ],
        "intermediate_refs": []
      }
    },
    "ThermalCycleEfficiency": {
      "eta_carnot": {
        "expr": "((inputs.t_hot - inputs.t_cold) / inputs.t_hot)",
        "input_refs": [
          "t_hot",
          "t_cold"
        ],
        "intermediate_refs": []
      },
      "eta_thermal": {
        "expr": "(eta_carnot * inputs.eta_real)",
        "input_refs": [
          "eta_real"
        ],
        "intermediate_refs": [
          "eta_carnot"
        ]
      }
    },
    "TorusMinorRadius": {
      "a": {
        "expr": "(((inputs.r_inner + inputs.r_outer) / 2.0) - inputs.r_major)",
        "input_refs": [
          "r_inner",
          "r_outer",
          "r_major"
        ],
        "intermediate_refs": []
      }
    },
    "TorusSurfaceArea": {
      "area": {
        "expr": "((((2.0 * 3.14159265359) * inputs.r_major) * inputs.a) * inputs.kappa)",
        "input_refs": [
          "r_major",
          "a",
          "kappa"
        ],
        "intermediate_refs": []
      }
    },
    "TorusVolume": {
      "volume": {
        "expr": "((((((2.0 * 3.14159265359) * 3.14159265359) * inputs.r_major) * inputs.a) * inputs.a) * inputs.kappa)",
        "input_refs": [
          "r_major",
          "a",
          "kappa"
        ],
        "intermediate_refs": []
      }
    },
    "TritiumBreedingRatio": {
      "tbr": {
        "expr": "inputs.tbr_assumed",
        "input_refs": [
          "tbr_assumed"
        ],
        "intermediate_refs": []
      }
    },
    "TritiumProcessingPower": {
