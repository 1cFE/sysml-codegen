+_INHERIT_COUNT = __import__("os").environ.get("NSM_INHERIT_COUNT", "1") == "1"
+
+
+def _redefined_endpoints(usage: Any) -> list[Any]:
+    result = []
+    for relationship in getattr(usage, "owned_redefinitions", ()) or ():
+        redefined = getattr(relationship, "redefined_feature", None)
+        if redefined is None:
+            continue
+        chain = list(getattr(redefined, "chaining_features", ()) or ())
+        result.append(chain[-1] if chain else redefined)
+    return result
+
+
+def _chain_flag(usage: Any, flag: str) -> bool:
+    """KerML 7.3.4.4/7.3.4.5: a redefinition of an ordered (nonunique) feature is one too."""
+    if getattr(usage, flag, False):
+        return True
+    if not _INHERIT_COUNT:
+        return False
+    return any(_chain_flag(endpoint, flag) for endpoint in _redefined_endpoints(usage))
+
+
+def _family_owns_non_part_features(usage: Any) -> bool:
+    for feature in getattr(usage, "owned_features", ()) or ():
+        if not SysideAdapter.is_instance(feature, "PartUsage"):
+            return True
+    return any(_family_owns_non_part_features(e) for e in _redefined_endpoints(usage))
+
+
+def _effective_multiplicity(usage: Any) -> tuple[Any, Any]:
+    """The usage's own multiplicity, or the one it inherits through redefinition."""
+    own = getattr(usage, "multiplicity", None)
+    if own is not None or not _INHERIT_COUNT:
+        return own, usage
+    found: dict[int, tuple[Any, Any]] = {}
+    for endpoint in _redefined_endpoints(usage):
+        multiplicity, owner = _effective_multiplicity(endpoint)
+        if multiplicity is not None:
+            found[id(multiplicity)] = (multiplicity, owner)
+    if len(found) > 1:
+        reference, location = authored_site(usage)
+        raise MultiplicityExpansionError(
+            ElaborationCode.SI_MULTIPLICITY_UNRESOLVED,
+            f"{reference} redefines features with different multiplicities and states none",
+            reference=reference,
+            location=location,
+            reason=SiteReason.OCCURRENCE_MULTIPLICITY_INHERITED_AMBIGUOUS,
+        )
+    return next(iter(found.values()), (None, usage))
+
