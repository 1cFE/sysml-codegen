+def _redefined_endpoints(usage: Any) -> tuple[Any, ...]:
+    """The parser declarations ``usage`` redefines (chain endpoints)."""
+    endpoints: list[Any] = []
+    for relationship in getattr(usage, "owned_redefinitions", ()) or ():
+        redefined = getattr(relationship, "redefined_feature", None)
+        if redefined is None:
+            continue
+        chain = list(getattr(redefined, "chaining_features", ()) or ())
+        endpoints.append(chain[-1] if chain else redefined)
+    return tuple(endpoints)
+
+
+def _effective_multiplicity(usage: Any) -> tuple[Any, Any]:
+    """The usage's own multiplicity, else the one it inherits through redefinition.
+
+    SysML Part 1 7.6.3 and KerML 7.3.4.5: a usage that declares no multiplicity
+    inherits that of the usages it redefines. Returns (multiplicity, its owner).
+    """
+    own = getattr(usage, "multiplicity", None)
+    if own is not None:
+        return own, usage
+    inherited: dict[int, tuple[Any, Any]] = {}
+    for endpoint in _redefined_endpoints(usage):
+        multiplicity, owner = _effective_multiplicity(endpoint)
+        if multiplicity is not None:
+            inherited[id(multiplicity)] = (multiplicity, owner)
+    if len(inherited) > 1:
+        reference, location = authored_site(usage)
+        raise MultiplicityExpansionError(
+            ElaborationCode.SI_MULTIPLICITY_UNRESOLVED,
+            f"{reference} redefines parts with different multiplicities and states none",
+            reference=reference,
+            location=location,
+            reason=SiteReason.OCCURRENCE_MULTIPLICITY_INHERITED_AMBIGUOUS,
+        )
+    if not inherited:
+        return None, usage
+    ((multiplicity, owner),) = inherited.values()
+    return multiplicity, owner
+
+
+def _is_ordered(usage: Any) -> bool:
+    """KerML 7.3.4.4/7.3.4.5: a redefinition of an ordered feature is ordered."""
+    return bool(getattr(usage, "is_ordered", False)) or any(
+        _is_ordered(endpoint) for endpoint in _redefined_endpoints(usage)
+    )
+
+
+def _is_nonunique(usage: Any) -> bool:
+    return bool(getattr(usage, "is_nonunique", False)) or any(
+        _is_nonunique(endpoint) for endpoint in _redefined_endpoints(usage)
+    )
+
+
+def _owns_non_part_features(usage: Any) -> bool:
+    """Whether ``usage`` or a declaration it redefines owns a non-part feature."""
+    return any(
+        not SysideAdapter.is_instance(feature, "PartUsage")
+        for feature in getattr(usage, "owned_features", ()) or ()
+    ) or any(_owns_non_part_features(endpoint) for endpoint in _redefined_endpoints(usage))
+
